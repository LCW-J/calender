# Neon pooled connection string（應用程式執行時使用，hostname 通常含 -pooler）
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Neon direct connection string（Prisma migration 使用）
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Google Cloud Console OAuth 2.0 Client
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 使用 `npx auth secret` 產生；請勿提交真實值
AUTH_SECRET=""

# Web Push：執行 `npm run push:keys` 產生一組固定金鑰。公鑰可公開，私鑰不可提交。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:YOUR_EMAIL@example.com"

# 保護 /api/cron/reminders；用 QStash 排程時以 Authorization: Bearer <此值> 傳入
CRON_SECRET=""

# QStash 延遲提醒：從 QStash Console 複製 Token 與目前 Region 的 REST URL。
# EU Region 範例：https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=""
QSTASH_URL="https://qstash-eu-central-1.upstash.io"
